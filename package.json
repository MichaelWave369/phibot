{
  "name": "@phi/phibot",
  "version": "0.8.0-alpha.0",
  "private": true,
  "description": "Governed purpose-built micro-agent runtime for the Phi ecosystem",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "phibot": "npm run build --silent && node dist/src/cli.js",
    "tool": "npm run build --silent && node dist/src/tool-cli.js",
    "service": "npm run build --silent && node dist/src/service-cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
